# Allow the web dashboard (running as 'autopilot') to run the toggle
# helper — and nothing else.  Modern sudo (>= 1.9.10) forbids
# wildcards in command arguments, so glider-name validation lives in
# the root-owned helper (deploy/autopilot-toggle), and this rule is an
# exact command path.
#
# Install (the visudo check first — a bad sudoers file locks out sudo):
#   sudo install -m 0755 -o root /opt/autopilot/deploy/autopilot-toggle /usr/local/sbin/
#   visudo -cf /opt/autopilot/deploy/sudoers-autopilot-web
#   sudo install -m 0440 /opt/autopilot/deploy/sudoers-autopilot-web /etc/sudoers.d/autopilot-web
autopilot ALL=(root) NOPASSWD: /usr/local/sbin/autopilot-toggle
