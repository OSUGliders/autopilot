[Unit]
Description=Mirror from-glider files for %i into the local acoustic-raw tree
After=network-online.target
Wants=network-online.target

[Service]
User=autopilot
Group=glider_pilots
UMask=0002
WorkingDirectory=/srv/autopilot
# --host is required because /etc/autopilot/credentials.json holds
# more than one SFMC host; real gliders live on gliderfmc0. Instances
# that don't (e.g. osusim, on gliderfmc1) need a host override -- see
# sfmc-pull-new-downloads@osusim.service.d/.
ExecStart=/opt/autopilot/.venv/bin/sfmc-pull-new-downloads %i \
    /srv/autopilot/acoustic-raw/%i \
    --credentials /etc/autopilot/credentials.json \
    --host gliderfmc0.ceoas.oregonstate.edu
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
