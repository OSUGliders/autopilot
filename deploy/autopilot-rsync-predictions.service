[Unit]
Description=Pull glider drifter predictions from the remote generator
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=autopilot
Group=glider_pilots
UMask=0002
# Edit REMOTE_HOST and the remote path for your site.
#
# Pull remote predictions.
ExecStart=/usr/bin/rsync -az --timeout=60 \
    -e "ssh -i /etc/autopilot/rsync_id_ed25519 -o UserKnownHostsFile=/etc/autopilot/known_hosts -o StrictHostKeyChecking=yes -o BatchMode=yes" \
    predictions@REMOTE_HOST:/path/to/localization/ /srv/autopilot/localization/
# Step 2: convert into per (deployment, float, tracker) prediction
ExecStart=/opt/autopilot/.venv/bin/autopilot-ingest-predictions \
    --localization-dir /srv/autopilot/localization/tracks \
    --predictions-dir /srv/autopilot/predictions
TimeoutStartSec=120
