[Unit]
Description=Acoustic-data watcher: osu1267 tbd interrogation-rate check
After=network-online.target sfmc-pull-new-downloads@osu1267.service
Wants=network-online.target

[Service]
User=autopilot
Group=glider_pilots
UMask=0002
WorkingDirectory=/srv/autopilot
# See autopilot-acoustic-watch-osusim-sbd.service for why HOME is set.
Environment=HOME=/srv/autopilot
# sci_generic_k == 10 marks an interrogation-sent event. Real osu1267
# tbd files (see gliderpilot_srv/acoustic-raw/osu1267, 367 files
# spanning 08-03 to 08-14) show it fires with a tight, near-clockwork
# inter-event gap of ~5.42 min during active phases (p10-p90 of the
# whole real gap distribution: 5.41-5.43 min) -- k==4/k==1 were checked
# too and are far less regular, not better candidates. Apparent
# per-file "bursts" (10-18 hits) are just longer segments spanning
# several 5.42-min cycles, not real bursts.
#
# --min-bytes 1000: real file sizes split cleanly -- a small-file
# cluster (surface/administrative segments, logged while the glider
# idles at the surface, not actively ranging) tops out at 647 bytes,
# essentially quantized (512/532/533/550/569/587...), then a real gap
# to the next real size at 1704 bytes. Only 2 of 198 files under that
# boundary ever contained a k==10 event. 1000 sits in the gap. These
# small files are fully exempted (not read, not counted toward the
# alert streak, not announced) -- correcting an earlier assumption:
# there is no legitimate quiet period for the acoustics once these are
# filtered out. The multi-hour zero-hit stretches seen in the 367-file
# history (up to 19 consecutive real-sized files) were not normal
# operation -- they were real failures that pilots had been catching
# and fixing by hand. --threshold is therefore set to the minimum (1):
# any real-sized file that fails alerts immediately, no streak
# required.
#
# --min-rate-per-minute is half the baseline rate (1/5.42, x2
# tolerance) -- catches spacing significantly greater than 5.42 min
# without flagging normal jitter within a single file.
ExecStart=/opt/autopilot/.venv/bin/autopilot-acoustic-watch \
    --glider osu1267 --extension tbd \
    --input-dir /srv/autopilot/acoustic-raw/osu1267 \
    --cache-dir /srv/autopilot/acoustic-cache \
    --variable sci_generic_k --equals 10 \
    --duration-variable sci_m_present_time --min-rate-per-minute 0.09 \
    --min-bytes 1000 \
    --threshold 1 \
    --ledger /srv/autopilot/acoustic-alert/osu1267-tbd.json \
    --slack-webhook-url-file /etc/autopilot/slack_webhook_url \
    --announce
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
