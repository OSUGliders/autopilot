[Unit]
Description=Acoustic-data watcher: osu1267 tbd interrogation-rate check
After=network-online.target sfmc-pull-new-downloads@osu1267.service
Wants=network-online.target

[Service]
User=autopilot
Group=glider_pilots
UMask=0002
WorkingDirectory=/srv/autopilot
# See autopilot-acoustic-watch-osusim-sbd.service for why HOME is set.
Environment=HOME=/srv/autopilot
# sci_generic_k == 10 marks an interrogation-sent event. Real osu1267
# tbd files (see gliderpilot_srv/acoustic-raw/osu1267, 367 files
# spanning 08-03 to 08-14) show it fires with a tight, near-clockwork
# inter-event gap of ~5.42 min during active phases (p10-p90 of the
# whole real gap distribution: 5.41-5.43 min) -- k==4/k==1 were checked
# too and are far less regular, not better candidates. Apparent
# per-file "bursts" (10-18 hits) are just longer segments spanning
# several 5.42-min cycles, not real bursts; "empty" segments are
# shorter ones that didn't span a full cycle. There are also normal
# multi-hour lulls with zero hits (up to 19 consecutive files, ~12.5h,
# e.g. 08-04 16:43 -> 08-05 05:16) that are a real part of operations,
# not a failure.
#
# --min-rate-per-minute is set to half the baseline rate (1/5.42, x2
# tolerance) -- catches spacing significantly greater than 5.42 min
# without flagging normal jitter. The rate threshold barely matters in
# practice (rates are essentially bimodal: ~0 or clearly at baseline);
# --threshold is what matters -- simulated against the full real
# history via ledger.record, --threshold 24 (and 20) produce zero false
# alarms across all 367 files including the worst known lull (19), while
# 10 and 15 both fire on routine, non-failure lulls.
ExecStart=/opt/autopilot/.venv/bin/autopilot-acoustic-watch \
    --glider osu1267 --extension tbd \
    --input-dir /srv/autopilot/acoustic-raw/osu1267 \
    --cache-dir /srv/autopilot/acoustic-cache \
    --variable sci_generic_k --equals 10 \
    --duration-variable sci_m_present_time --min-rate-per-minute 0.09 \
    --threshold 24 \
    --ledger /srv/autopilot/acoustic-alert/osu1267-tbd.json \
    --slack-webhook-url-file /etc/autopilot/slack_webhook_url
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
