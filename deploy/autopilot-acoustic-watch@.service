[Unit]
Description=Acoustic-data watcher: %i tbd interrogation-rate check
After=network-online.target sfmc-pull-new-downloads@%i.service
Wants=network-online.target

[Service]
User=autopilot
Group=glider_pilots
UMask=0002
WorkingDirectory=/srv/autopilot
# dbdreader creates $HOME/.local/share/dbdreader at import time
# (unrelated to --cache-dir, which is our own .cac repository) -- the
# autopilot service account has no writable home.
Environment=HOME=/srv/autopilot
# sci_generic_k == 10 marks an interrogation-sent event. Everything
# below was calibrated on real osu1267 data (367 tbd files, 08-03 to
# 08-14)
#
# - Interrogations fire every ~5.42 min during RIOT 2026 IOP, equivalent to 0.18 per min 
# --min-rate-per-minute 0.14 is a 7 min rate. 
# - --min-bytes 1000: small administrative surface segments are skipped
# - --threshold 1: with small files exempted the rest should contain acoustics
ExecStart=/opt/autopilot/.venv/bin/autopilot-acoustic-watch \
    --glider %i --extension tbd \
    --input-dir /srv/autopilot/acoustic-raw/%i \
    --cache-dir /srv/autopilot/acoustic-cache \
    --variable sci_generic_k --equals 10 \
    --duration-variable sci_m_present_time --min-rate-per-minute 0.14 \
    --min-bytes 1000 \
    --threshold 1 \
    --ledger /srv/autopilot/acoustic-alert/%i-tbd.json \
    --slack-webhook-url-file /etc/autopilot/slack_webhook_url \
    --announce
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
