[Unit]
Description=Glider autopilot follower for %i
After=network-online.target
Wants=network-online.target

[Service]
User=autopilot
Group=glider_pilots
UMask=0002
WorkingDirectory=/srv/autopilot
# --hostname, --notify-email, --notify-from are filled in by
# autopilot-follow from this glider's own config (sfmc_hostname,
# notify_email, notify_from) — see osu999_config.yaml.
ExecStart=/opt/autopilot/.venv/bin/autopilot-follow --glider %i \
    --follower /opt/autopilot/src/autopilot/follower.py \
    --config /srv/autopilot/%i_config.yaml \
    --credentials /etc/autopilot/credentials.json \
    --logfile /srv/autopilot/logs/%i.log
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
